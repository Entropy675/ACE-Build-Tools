{
  "schema_version": 1,

  "module": {
    "name": "LayoutProvider",
    "std": "c++17",
    "platforms": [
      "Linux",
      "Win"
    ],
    "impl_layout": "shared"
  },

  "requires": {
    "system": {
      "debian": [
        { "package": "git", "probe": "binary:git" }
      ],
      "arch": [
        { "package": "git", "probe": "binary:git" }
      ],
      "fedora": [
        { "package": "git", "probe": "binary:git" }
      ]
    },

    "vendor": [
      {
        "name": "clay",
        "source": {
          "type": "vendored",
          "path": "clay"
        },
        "arch_sensitive": false,
        "hash_scope": false
      }
    ]
  },

  "build": {
    "common": {
      "cxxflags": [
        "-fpermissive"
      ]
    },
    "Linux": {
      "ldflags": [
        "-pthread"
      ],
      "system_libs": [
        "dl"
      ]
    },
    "Win": {
      "system_libs": [
        "ws2_32"
      ]
    }
  },

  "produces": {
    "kind": "etcs_module",
    "exports": "exports.map",
    "install": "bin/"
  }
}
