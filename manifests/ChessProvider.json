{
  "schema_version": 1,
  "module": {
    "name": "ChessProvider",
    "std": "c++17",
    "platforms": [
      "Linux",
      "Win",
      "Web"
    ]
  },
  "requires": {
    "system": {
      "debian": [
        {
          "package": "git",
          "probe": "binary:git"
        }
      ],
      "arch": [
        {
          "package": "git",
          "probe": "binary:git"
        }
      ],
      "fedora": [
        {
          "package": "git",
          "probe": "binary:git"
        }
      ]
    },
    "vendor": [
      {
        "name": "CChess",
        "source": {
          "type": "vendored",
          "path": "ChessProvider/CChess"
        },
        "hash_scope": false,
        "arch_sensitive": false,
        "provides": {
          "sources": {
            "include": [
              "src/*.cc",
              "src/piece_behav/*.cc"
            ],
            "exclude": [
              "src/main.cc",
              "src/ChessGame.cc",
              "src/ChessGameLinux.cc",
              "src/ChessGameWindows.cc",
              "src/NcView.cc",
              "src/WinView.cc"
            ]
          }
        }
      },
      {
        "name": "stb",
        "_comment": "stb_image, for the board's piece pictures (CChess's piece_images): one public-domain header at PaintProvider's pin, compiled once and static in ChessProvider.cc, PNG only.",
        "source": {
          "type": "git",
          "url": "https://github.com/nothings/stb.git",
          "ref": "2c980bb59875b0d32144a71867fbdebb2f77cd20",
          "shallow": true
        },
        "build": {
          "system": "none"
        },
        "arch_sensitive": false,
        "hash_scope": false,
        "provides": {
          "include": [
            "."
          ]
        }
      }
    ]
  },
  "build": {
    "common": {
      "cxxflags": [
        "-fpermissive"
      ]
    },
    "Linux": {
      "ldflags": [
        "-pthread"
      ],
      "system_libs": [
        "dl"
      ]
    },
    "Win": {
      "system_libs": [
        "ws2_32"
      ]
    },
    "Web": {
      "compiler": "em++"
    }
  },
  "produces": {
    "kind": "etcs_module",
    "exports": "exports.map",
    "install": "bin/"
  }
}
