{
  "schema_version": 1,
  "module": {
    "name": "DatabaseProvider",
    "std": "c++17",
    "platforms": [
      "Linux",
      "Win",
      "Web"
    ],
    "impl_layout": "shared"
  },
  "requires": {
    "system": {
      "debian": [
        {
          "package": "git",
          "probe": "binary:git"
        }
      ],
      "arch": [
        {
          "package": "git",
          "probe": "binary:git"
        }
      ],
      "fedora": [
        {
          "package": "git",
          "probe": "binary:git"
        }
      ]
    },
    "vendor": [
      {
        "name": "sqlite",
        "source": {
          "type": "git",
          "url": "https://github.com/sqlite/sqlite.git",
          "ref": "8ded81032221fd3d1d5d19868f63715a74dd469b",
          "shallow": true
        },
        "build": {
          "system": "autotools",
          "configure_args": [],
          "targets": [
            "sqlite3.c"
          ]
        },
        "arch_sensitive": true,
        "hash_scope": false,
        "provides": {
          "include": [
            "."
          ],
          "sources": {
            "include": [
              "sqlite3.c"
            ],
            "cflags": [
              "-O2",
              "-fPIC",
              "-DSQLITE_ENABLE_COLUMN_METADATA",
              "-DSQLITE_ENABLE_RTREE",
              "-DSQLITE_THREADSAFE=1",
              "-DSQLITE_OMIT_LOAD_EXTENSION"
            ]
          }
        }
      }
    ]
  },
  "build": {
    "Linux": {
      "ldflags": [
        "-pthread"
      ],
      "system_libs": [
        "dl"
      ]
    },
    "Win": {
      "system_libs": [
        "ws2_32"
      ]
    },
    "Web": {
      "compiler": "em++",
      "_comment": "IDBFS is how a database at a path outlives the tab: the page mounts /persist on it and syncs to IndexedDB. The loader links the library; this is where it is asked for, beside the module that needs it.",
      "ldflags": [
        "-lidbfs.js"
      ]
    }
  },
  "produces": {
    "kind": "etcs_module",
    "exports": "exports.map",
    "install": "bin/"
  }
}
